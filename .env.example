# =============================================================================
# DH1_MMORPG 환경 변수 템플릿
# 이 파일을 복사해 .env로 이름을 바꾸고 값을 채워주세요.
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# MySQL
# -----------------------------------------------------------------------------
DH1_MYSQL_HOST=127.0.0.1
DH1_MYSQL_PORT=3306
DH1_MYSQL_USER=root
DH1_MYSQL_PASSWORD=

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
DH1_REDIS_HOST=127.0.0.1
DH1_REDIS_PORT=6379

# -----------------------------------------------------------------------------
# NavMesh (S3 only)
# -----------------------------------------------------------------------------
# S3 리전 (AWS CLI 다운로드 시 사용)
DH1_S3_REGION=ap-northeast-2
# AWS CLI profile
DH1_AWS_PROFILE=dh1
# 선택: AWS CLI 절대 경로 (미설정 시 기본 경로 또는 PATH의 aws 사용)
# DH1_AWS_CLI_PATH=C:/Program Files/Amazon/AWSCLIV2/aws.exe
# S3에서 NavMesh를 내려받을 때 사용할 로컬 캐시 경로
DH1_NAVMESH_CACHE_PATH=C:/Projects/DH1_MMORPG/Shared/NavMesh/Downloaded/world_1.bin
# NavMesh S3 경로는 world_navmesh_source.navmesh_path(s3://...)에서 관리

# -----------------------------------------------------------------------------
# SMTP (LoginServer)
# smtp.gmail.com / smtp.naver.com / smtp.daum.net 등
# -----------------------------------------------------------------------------
DH1_SMTP_HOST=smtp.gmail.com
DH1_SMTP_SENDER_EMAIL=
DH1_SMTP_APP_PASSWORD=

# -----------------------------------------------------------------------------
# MCP / External integrations
# -----------------------------------------------------------------------------
BRAVE_API_KEY=
GITHUB_PERSONAL_ACCESS_TOKEN=
FLOPPERAM_API_KEY=
FIRECRAWL_API_KEY=

# -----------------------------------------------------------------------------
# Client launch (optional for StartGame.bat)
# -----------------------------------------------------------------------------
# 둘 다 지정한 경우에만 StartGame.bat에서 해상도 강제 적용
# DH1_CLIENT_RESX=1600
# DH1_CLIENT_RESY=900

# -----------------------------------------------------------------------------
# 로그 / 크래시 덤프 경로 (절대 경로)
# -----------------------------------------------------------------------------
DH1_LOG_DIR=C:/Projects/DH1_MMORPG/Logs
DH1_CRASH_DIR=C:/Projects/DH1_MMORPG/Crashes
DH1_CRASH_HANDLER_PATH=C:/Projects/DH1_MMORPG/Shared/Tools/CrashHandler/crashpad_handler.exe
