{
    "server": {
        "ip": "0.0.0.0",
        "port": 9000,
        "acceptCount": 100,
        "maxSessionCount": 10000,
        "sessionTimeoutMs": 120000
    },
    "session": {
        "receiveBufferSize": 16384,
        "sendBufferSize": 16384
    },
    "networkScheduler": {
        "runningThreadCount": 0,
        "waitTimeoutMs": 16,
        "tickIntervalMs": 16,
        "dispatchThreadCount": 8
    },
    "actorScheduler": {
        "runningThreadCount": 0,
        "waitTimeoutMs": 16,
        "tickIntervalMs": 16,
        "dispatchThreadCount": 4
    },
    "redis": {
        "connectionUri": "tcp://${DH1_REDIS_HOST}:${DH1_REDIS_PORT}?pool_size=10"
    },
    "gateway": {
        "gatewayId": 1,
        "heartbeatIntervalMs": 5000,
        "redisTtlSeconds": 10
    },
    "mysql": {
        "host": "127.0.0.1",
        "port": 3306,
        "user": "root",
        "password": "${DH1_MYSQL_PASSWORD}",
        "database": "dh1_gateway_db"
    }
}
