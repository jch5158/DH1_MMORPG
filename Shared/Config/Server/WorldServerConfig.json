{
    "server": {
        "ip": "0.0.0.0",
        "port": 9100,
        "acceptCount": 10,
        "maxSessionCount": 100,
        "sessionTimeoutMs": 120000
    },
    "mysql": {
        "host": "127.0.0.1",
        "port": 3306,
        "user": "root",
        "password": "${DH1_MYSQL_PASSWORD}",
        "database": "dh1_game_db",
        "poolSize": 4
    },
    "worldServer": {
        "worldServerId": 1,
        "worldName": "World-1",
        "navMeshMapCode": "L_GameWorld",
        "maxPlayers": 1000,
        "heartbeatIntervalMs": 5000,
        "gatewayHeartbeatTimeoutMs": 15000,
        "realmHeartbeatTimeoutMs": 15000,
        "redisTtlSeconds": 10
    },
    "gameTick": {
        "tickIntervalMs": 50,
        "moveSpeed": 600,
        "aoiCellSize": 2000,
        "aoiRange": 1,
        "navMeshRequireSuccess": true,
        "navMeshS3Region": "${DH1_S3_REGION}",
        "navMeshCacheFilePath": "${DH1_NAVMESH_CACHE_PATH}",
        "navMeshDownloadRetryCount": 8,
        "navMeshDownloadRetryDelayMs": 1500
    },
    "realmServer": {
        "ip": "127.0.0.1",
        "port": 9200,
        "reconnectIntervalMs": 3000
    },
    "redis": {
        "connectionUri": "tcp://${DH1_REDIS_HOST}:${DH1_REDIS_PORT}?pool_size=5"
    },
    "session": {
        "receiveBufferSize": 16384,
        "sendBufferSize": 16384
    },
    "networkScheduler": {
        "runningThreadCount": 2,
        "waitTimeoutMs": 10,
        "tickIntervalMs": 16
    },
    "actorScheduler": {
        "runningThreadCount": 2,
        "waitTimeoutMs": 10,
        "tickIntervalMs": 16
    }
}
