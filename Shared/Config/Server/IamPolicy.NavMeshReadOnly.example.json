{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowReadNavMeshObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::dh1-navmesh-prod/navmesh/*"
      ]
    },
    {
      "Sid": "AllowListBucketPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::dh1-navmesh-prod",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "navmesh/*"
          ]
        }
      }
    }
  ]
}
