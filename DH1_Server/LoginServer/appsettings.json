{
  "SmtpSettings": {
    "Host": "${DH1_SMTP_HOST}",
    "Port": 587,
    "SenderEmail": "${DH1_SMTP_SENDER_EMAIL}",
    "SenderName": "DH1_MMORPG Admin",
    "AppPassword": "${DH1_SMTP_APP_PASSWORD}"
  },
  "ConnectionStrings": {
    "AccountDbConnection": "Server=localhost;Port=3306;Database=dh1_account_db;Uid=root;Pwd=${DH1_MYSQL_PASSWORD};",
    "RedisConnection": "${DH1_REDIS_HOST}:${DH1_REDIS_PORT}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5080"
      },
      "Https": {
        "Url": "https://0.0.0.0:5001"
      }
    }
  }
}
